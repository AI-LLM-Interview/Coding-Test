   "source": [
    "def solution(s):\n",
    "    count = 0\n",
    "    for c in s:\n",
    "        if c == '(':\n",
    "            count += 1\n",
    "        else:\n",
    "            count -= 1\n",
    "        if count < 0:\n",
    "            return False\n",
    "    return count == 0\n"
   ]
  }
