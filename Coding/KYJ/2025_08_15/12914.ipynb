   "source": [
    "def solution(n):\n",
    "    MOD = 1234567\n",
    "    if n <= 1:\n",
    "        return 1\n",
    "    \n",
    "    a, b = 1, 1  \n",
    "    \n",
    "    for _ in range(2, n + 1):\n",
    "        a, b = b, (a + b) % MOD\n",
    "    return b"
   ]
  }
