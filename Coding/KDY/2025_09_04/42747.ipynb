   "source": [
    "def solution(citations):\n",
    "    citations.sort()\n",
    "    n = len(citations)\n",
    "    for i in range(n):\n",
    "        h = n - i\n",
    "        if citations[i] >= h:\n",
    "            return h\n",
    "    return 0"
   ]
  }
