   "source": [
    "### 이진 변환 반복하기"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "6b1ebbae",
   "metadata": {
    "vscode": {
     "languageId": "plaintext"
    }
   },
   "outputs": [],
   "source": [
    "def solution(s):\n",
    "    answer = [0,0]\n",
    "    while s != '1':\n",
    "        new_s = s.replace('0','')\n",
    "        k = len(s)-len(new_s)\n",
    "        answer[0] += 1\n",
    "        answer[1] += k\n",
    "        s = bin(len(new_s))[2:]\n",
    "        # bin(len(new_s)).replace('0b','')\n",
    "    \n",
    "    return answer"
   ]
  }
