    "def solution(word):\n",
    "    \n",
    "    weights = [781, 156, 31, 6, 1]\n",
    "    letters = {'A':0, 'E':1, 'I':2, 'O':3, 'U':4}\n",
    "\n",
    "    answer = 0\n",
    "    for i, ch in enumerate(word):\n",
    "        answer += letters[ch] * weights[i] + 1\n",
    "\n",
    "    return answer"
   ]
  }
