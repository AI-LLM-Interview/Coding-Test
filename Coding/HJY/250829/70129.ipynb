   "source": [
    "def solution(x):\n",
    "    a, b = 0, 0\n",
    "    while x != \"1\":\n",
    "        b += x.count(\"0\")\n",
    "        x = bin(x.count(\"1\"))[2:]\n",
    "        a += 1\n",
    "    return [a, b]"
   ]
