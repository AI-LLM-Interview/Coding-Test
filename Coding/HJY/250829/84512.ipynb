   "source": [
    "# AEIOU\n",
    "dic = {'A':1, 'E':2, 'I':3, 'O':4, 'U':5}\n",
    "\n",
    "def solution(word):\n",
    "    answer = 0\n",
    "    arr = [780, 155, 30, 5, 0]\n",
    "    for i, c in enumerate(word):\n",
    "        answer += (dic[c] - 1) * arr[i] + dic[c]\n",
    "    return answer"
   ]
  }
