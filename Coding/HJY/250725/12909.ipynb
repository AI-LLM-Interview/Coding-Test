    "def solution(s):\n",
    "    stack = 0\n",
    "    for c in s:\n",
    "        if c == \"(\":\n",
    "            stack += 1\n",
    "        else:\n",
    "            if stack == 0:\n",
    "                return False\n",
    "            stack -= 1\n",
    "    return stack == 0"
   ]
