   "source": [
    "import heapq\n",
    "\n",
    "def solution(S, K):\n",
    "    # heapq.heapify(S)\n",
    "    S.sort()\n",
    "    answer = 0\n",
    "    while S[0] < K:\n",
    "        if len(S) < 2:\n",
    "            return -1\n",
    "        s1 = heapq.heappop(S)\n",
    "        s2 = heapq.heappop(S)\n",
    "        heapq.heappush(S, s1 + s2*2)\n",
    "        answer += 1\n",
    "    return answer"
   ]
  }
