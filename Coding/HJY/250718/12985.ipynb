   "source": [
    "def solution(n,a,b):\n",
    "    answer = 0\n",
    "    arr = [0]*n\n",
    "    arr[a-1] = 1\n",
    "    arr[b-1] = 1\n",
    "    while 2 not in arr:\n",
    "        answer += 1\n",
    "        temp = []\n",
    "        for i in range(0, len(arr), 2):\n",
    "            temp.append(arr[i] + arr[i+1])\n",
    "        arr = temp\n",
    "    return answer"
   ]
  }
