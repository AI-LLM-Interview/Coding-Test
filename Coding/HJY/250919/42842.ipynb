   "source": [
    "def solution(brown, yellow):\n",
    "    answer = []\n",
    "    n = brown + yellow\n",
    "    for h in range(3, brown):\n",
    "        for w in range(3, brown):\n",
    "            if w * h == n and 2*(w + h - 2) == brown and (w - 2) * (h - 2) == yellow:\n",
    "                return [w, h]\n",
    "    return answer"
   ]
  }
