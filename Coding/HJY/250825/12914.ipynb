   "source": [
    "from math import factorial\n",
    "\n",
    "def solution(n):\n",
    "    answer = 0\n",
    "    for two in range(n//2+1):\n",
    "        one = n - two * 2\n",
    "        answer += factorial(one + two) // factorial(one) // factorial(two)\n",
    "    return answer % 1234567"
   ]
  }
